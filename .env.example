# ==========================================================
# FINETHY Fact-Finder: environment variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env`; it holds secrets.
# ==========================================================

# --- Database --------------------------------------------
# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# --- Advisor login ---------------------------------------
ADVISOR_USERNAME="advisor"
# Use a long, unique password (12+ characters).
ADVISOR_PASSWORD="change-me-to-a-long-password"
# Secret used to sign advisor login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a secret is derived from ADVISOR_PASSWORD (changing the password then logs everyone out).
SESSION_SECRET=""

# --- Public URL ------------------------------------------
# Used to build the client links you share (WhatsApp / copy link) and in emails.
# (NEXT_PUBLIC_APP_URL from older setups still works.)
APP_URL="http://localhost:3000"

# --- Email notifications ---------------------------------
# Advisor inbox that receives the PDF report when a client submits.
ADVISOR_EMAIL="advisor@example.com"

# SMTP (leave SMTP_USER / SMTP_PASS empty to log emails to the console instead)
# Gmail: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"FINETHY Fact-Finder\" <no-reply@example.com>"
